//@version=6
indicator("Institutional S/R Flip", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// =============================================================================
// INPUTS
// =============================================================================
string GRP_STRUCT = "Multi-Timeframe Structure"
int pivotLen = input.int(5, "Pivot Lookback Length", minval=2, group=GRP_STRUCT)
bool show1H = input.bool(true, "Show 1H Levels", group=GRP_STRUCT)
bool show4H = input.bool(true, "Show 4H Levels", group=GRP_STRUCT)
bool showDaily = input.bool(true, "Show Daily Levels", group=GRP_STRUCT)

string GRP_BENCH = "Institutional Benchmarks"
bool showPWHL = input.bool(true, "Show Prev Week High/Low", group=GRP_BENCH)
bool showPDOC = input.bool(true, "Show Prev Day Open/Close", group=GRP_BENCH)

string GRP_PSYCH = "Psychology Numbers"
bool showPsych = input.bool(true, "Show Psychology Numbers", group=GRP_PSYCH)
float psychStep = input.float(100, "Round Number Step Size", minval=1, group=GRP_PSYCH)
int psychCount = input.int(5, "Levels Above/Below Price", minval=1, maxval=20, group=GRP_PSYCH)

string GRP_FILT = "Confluence and Cleaning"
float proxPct = input.float(0.15, "Proximity Filter Pct", minval=0.01, step=0.01, group=GRP_FILT)
float confPct = input.float(0.30, "Confluence Zone Width Pct", minval=0.05, step=0.05, group=GRP_FILT)
int confMinLvls = input.int(3, "Min Levels for Confluence", minval=2, group=GRP_FILT)

string GRP_FLIP = "Break and Retest Logic"
int atrLen = input.int(14, "ATR Length", minval=1, group=GRP_FLIP)
float atrMult = input.float(0.5, "ATR Retest Multiplier", minval=0.1, step=0.1, group=GRP_FLIP)
int volLen = input.int(20, "Volume MA Length", minval=1, group=GRP_FLIP)

string GRP_VIS = "Visuals"
int maxLevels = input.int(50, "Max Tracked Levels", minval=10, maxval=200, group=GRP_VIS)

// =============================================================================
// PARALLEL ARRAYS FOR LEVEL DATA
// =============================================================================
var array<float> lvl_price = array.new<float>()
var array<string> lvl_tf = array.new<string>()
var array<string> lvl_kind = array.new<string>()
var array<int> lvl_priority = array.new<int>()
var array<bool> lvl_isBroken = array.new<bool>()
var array<bool> lvl_breakIsUp = array.new<bool>()
var array<float> lvl_breakVol = array.new<float>()
var array<int> lvl_breakBar = array.new<int>()
var array<bool> lvl_isRetested = array.new<bool>()
var array<bool> lvl_isActive = array.new<bool>()
var array<bool> lvl_isConfluence = array.new<bool>()
var array<bool> lvl_isHidden = array.new<bool>()
var array<int> lvl_createdBar = array.new<int>()
var array<line> lvl_ln = array.new<line>()
var array<label> lvl_lb = array.new<label>()
var array<box> confBoxes = array.new<box>()

float atrVal = ta.atr(atrLen)
float volMA = ta.sma(volume, volLen)

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================
f_getPriority(string tfId) =>
    int result = 1
    if tfId == "D"
        result := 5
    else if tfId == "4H"
        result := 4
    else if tfId == "1H"
        result := 3
    else if tfId == "PWH" or tfId == "PWL" or tfId == "PDO" or tfId == "PDC"
        result := 2
    result

f_getColor(string tfId) =>
    color result = color.new(color.silver, 0)
    if tfId == "D"
        result := color.new(color.blue, 0)
    else if tfId == "4H"
        result := color.new(color.orange, 0)
    else if tfId == "1H"
        result := color.new(color.gray, 0)
    else if tfId == "PWH" or tfId == "PWL"
        result := color.new(color.purple, 0)
    else if tfId == "PDO" or tfId == "PDC"
        result := color.new(color.green, 0)
    result

f_getStyle(string tfId) =>
    string result = line.style_dotted
    if tfId == "D"
        result := line.style_solid
    else if tfId == "4H" or tfId == "PWH" or tfId == "PWL" or tfId == "PDO" or tfId == "PDC"
        result := line.style_dashed
    result

f_getWidth(string tfId) =>
    int result = 1
    if tfId == "D" or tfId == "PWH" or tfId == "PWL" or tfId == "PDO" or tfId == "PDC"
        result := 2
    result

f_levelExists(float p, string tfId) =>
    bool found = false
    if array.size(lvl_price) > 0
        for i = 0 to array.size(lvl_price) - 1
            if array.get(lvl_tf, i) == tfId and math.abs(array.get(lvl_price, i) - p) < syminfo.mintick * 2
                found := true
                break
    found

f_addLevel(float p, string tfId, string knd) =>
    if not na(p) and not f_levelExists(p, tfId)
        array.push(lvl_price, p)
        array.push(lvl_tf, tfId)
        array.push(lvl_kind, knd)
        array.push(lvl_priority, f_getPriority(tfId))
        array.push(lvl_isBroken, false)
        array.push(lvl_breakIsUp, false)
        array.push(lvl_breakVol, 0.0)
        array.push(lvl_breakBar, 0)
        array.push(lvl_isRetested, false)
        array.push(lvl_isActive, true)
        array.push(lvl_isConfluence, false)
        array.push(lvl_isHidden, false)
        array.push(lvl_createdBar, bar_index)
        array.push(lvl_ln, line(na))
        array.push(lvl_lb, label(na))

f_removeLevel(int idx) =>
    line tempLn = array.get(lvl_ln, idx)
    label tempLb = array.get(lvl_lb, idx)
    if not na(tempLn)
        line.delete(tempLn)
    if not na(tempLb)
        label.delete(tempLb)
    array.remove(lvl_price, idx)
    array.remove(lvl_tf, idx)
    array.remove(lvl_kind, idx)
    array.remove(lvl_priority, idx)
    array.remove(lvl_isBroken, idx)
    array.remove(lvl_breakIsUp, idx)
    array.remove(lvl_breakVol, idx)
    array.remove(lvl_breakBar, idx)
    array.remove(lvl_isRetested, idx)
    array.remove(lvl_isActive, idx)
    array.remove(lvl_isConfluence, idx)
    array.remove(lvl_isHidden, idx)
    array.remove(lvl_createdBar, idx)
    array.remove(lvl_ln, idx)
    array.remove(lvl_lb, idx)

f_trimLevels() =>
    if array.size(lvl_price) > maxLevels
        int i = 0
        while i < array.size(lvl_price) and array.size(lvl_price) > maxLevels
            if array.get(lvl_isRetested, i)
                f_removeLevel(i)
            else
                i += 1
        while array.size(lvl_price) > maxLevels
            f_removeLevel(0)

// =============================================================================
// PHASE A: MULTI-TIMEFRAME PIVOTS (Non-Repainting)
// =============================================================================
f_pivHi() =>
    ta.pivothigh(high, pivotLen, pivotLen)

f_pivLo() =>
    ta.pivotlow(low, pivotLen, pivotLen)

float ph1H = request.security(syminfo.tickerid, "60", f_pivHi()[1], barmerge.gaps_on, barmerge.lookahead_on)
float pl1H = request.security(syminfo.tickerid, "60", f_pivLo()[1], barmerge.gaps_on, barmerge.lookahead_on)
float ph4H = request.security(syminfo.tickerid, "240", f_pivHi()[1], barmerge.gaps_on, barmerge.lookahead_on)
float pl4H = request.security(syminfo.tickerid, "240", f_pivLo()[1], barmerge.gaps_on, barmerge.lookahead_on)
float phD = request.security(syminfo.tickerid, "D", f_pivHi()[1], barmerge.gaps_on, barmerge.lookahead_on)
float plD = request.security(syminfo.tickerid, "D", f_pivLo()[1], barmerge.gaps_on, barmerge.lookahead_on)

if show1H and not na(ph1H)
    f_addLevel(ph1H, "1H", "pivot_high")
if show1H and not na(pl1H)
    f_addLevel(pl1H, "1H", "pivot_low")
if show4H and not na(ph4H)
    f_addLevel(ph4H, "4H", "pivot_high")
if show4H and not na(pl4H)
    f_addLevel(pl4H, "4H", "pivot_low")
if showDaily and not na(phD)
    f_addLevel(phD, "D", "pivot_high")
if showDaily and not na(plD)
    f_addLevel(plD, "D", "pivot_low")

// =============================================================================
// PHASE A: INSTITUTIONAL BENCHMARKS (Non-Repainting)
// =============================================================================
float weekHi = request.security(syminfo.tickerid, "W", high[1], barmerge.gaps_on, barmerge.lookahead_on)
float weekLo = request.security(syminfo.tickerid, "W", low[1], barmerge.gaps_on, barmerge.lookahead_on)
float dayOpen = request.security(syminfo.tickerid, "D", open[1], barmerge.gaps_on, barmerge.lookahead_on)
float dayClose = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_on, barmerge.lookahead_on)

var float _prevPWH = na
var float _prevPWL = na
var float _prevPDO = na
var float _prevPDC = na

if showPWHL and not na(weekHi) and weekHi != _prevPWH
    if array.size(lvl_price) > 0
        for i = array.size(lvl_price) - 1 to 0
            if array.get(lvl_tf, i) == "PWH" and not array.get(lvl_isBroken, i)
                f_removeLevel(i)
                break
    f_addLevel(weekHi, "PWH", "benchmark")
    _prevPWH := weekHi

if showPWHL and not na(weekLo) and weekLo != _prevPWL
    if array.size(lvl_price) > 0
        for i = array.size(lvl_price) - 1 to 0
            if array.get(lvl_tf, i) == "PWL" and not array.get(lvl_isBroken, i)
                f_removeLevel(i)
                break
    f_addLevel(weekLo, "PWL", "benchmark")
    _prevPWL := weekLo

if showPDOC and not na(dayOpen) and dayOpen != _prevPDO
    if array.size(lvl_price) > 0
        for i = array.size(lvl_price) - 1 to 0
            if array.get(lvl_tf, i) == "PDO" and not array.get(lvl_isBroken, i)
                f_removeLevel(i)
                break
    f_addLevel(dayOpen, "PDO", "benchmark")
    _prevPDO := dayOpen

if showPDOC and not na(dayClose) and dayClose != _prevPDC
    if array.size(lvl_price) > 0
        for i = array.size(lvl_price) - 1 to 0
            if array.get(lvl_tf, i) == "PDC" and not array.get(lvl_isBroken, i)
                f_removeLevel(i)
                break
    f_addLevel(dayClose, "PDC", "benchmark")
    _prevPDC := dayClose

// =============================================================================
// PHASE A: PSYCHOLOGY NUMBERS
// =============================================================================
if showPsych and barstate.islast
    if array.size(lvl_price) > 0
        for i = array.size(lvl_price) - 1 to 0
            if array.get(lvl_tf, i) == "PSYCH"
                f_removeLevel(i)
    float baseLevel = math.floor(close / psychStep) * psychStep
    for j = -psychCount to psychCount
        float pLevel = baseLevel + j * psychStep
        if pLevel > 0
            f_addLevel(pLevel, "PSYCH", "psych")

// =============================================================================
// TRIM EXCESS LEVELS
// =============================================================================
f_trimLevels()

// =============================================================================
// PHASE B: PROXIMITY FILTER
// =============================================================================
int sz = array.size(lvl_price)
if sz > 0
    for i = 0 to sz - 1
        array.set(lvl_isHidden, i, false)
        array.set(lvl_isConfluence, i, false)

// Sort by price (bubble sort, small arrays)
if sz > 1
    for i = 0 to sz - 2
        for j = 0 to sz - i - 2
            if array.get(lvl_price, j) > array.get(lvl_price, j + 1)
                // Swap all parallel arrays
                float tmpF = 0.0
                string tmpS = ""
                int tmpI = 0
                bool tmpB = false
                line tmpLn = line(na)
                label tmpLb = label(na)

                tmpF := array.get(lvl_price, j)
                array.set(lvl_price, j, array.get(lvl_price, j + 1))
                array.set(lvl_price, j + 1, tmpF)

                tmpS := array.get(lvl_tf, j)
                array.set(lvl_tf, j, array.get(lvl_tf, j + 1))
                array.set(lvl_tf, j + 1, tmpS)

                tmpS := array.get(lvl_kind, j)
                array.set(lvl_kind, j, array.get(lvl_kind, j + 1))
                array.set(lvl_kind, j + 1, tmpS)

                tmpI := array.get(lvl_priority, j)
                array.set(lvl_priority, j, array.get(lvl_priority, j + 1))
                array.set(lvl_priority, j + 1, tmpI)

                tmpB := array.get(lvl_isBroken, j)
                array.set(lvl_isBroken, j, array.get(lvl_isBroken, j + 1))
                array.set(lvl_isBroken, j + 1, tmpB)

                tmpB := array.get(lvl_breakIsUp, j)
                array.set(lvl_breakIsUp, j, array.get(lvl_breakIsUp, j + 1))
                array.set(lvl_breakIsUp, j + 1, tmpB)

                tmpF := array.get(lvl_breakVol, j)
                array.set(lvl_breakVol, j, array.get(lvl_breakVol, j + 1))
                array.set(lvl_breakVol, j + 1, tmpF)

                tmpI := array.get(lvl_breakBar, j)
                array.set(lvl_breakBar, j, array.get(lvl_breakBar, j + 1))
                array.set(lvl_breakBar, j + 1, tmpI)

                tmpB := array.get(lvl_isRetested, j)
                array.set(lvl_isRetested, j, array.get(lvl_isRetested, j + 1))
                array.set(lvl_isRetested, j + 1, tmpB)

                tmpB := array.get(lvl_isActive, j)
                array.set(lvl_isActive, j, array.get(lvl_isActive, j + 1))
                array.set(lvl_isActive, j + 1, tmpB)

                tmpB := array.get(lvl_isConfluence, j)
                array.set(lvl_isConfluence, j, array.get(lvl_isConfluence, j + 1))
                array.set(lvl_isConfluence, j + 1, tmpB)

                tmpB := array.get(lvl_isHidden, j)
                array.set(lvl_isHidden, j, array.get(lvl_isHidden, j + 1))
                array.set(lvl_isHidden, j + 1, tmpB)

                tmpI := array.get(lvl_createdBar, j)
                array.set(lvl_createdBar, j, array.get(lvl_createdBar, j + 1))
                array.set(lvl_createdBar, j + 1, tmpI)

                tmpLn := array.get(lvl_ln, j)
                array.set(lvl_ln, j, array.get(lvl_ln, j + 1))
                array.set(lvl_ln, j + 1, tmpLn)

                tmpLb := array.get(lvl_lb, j)
                array.set(lvl_lb, j, array.get(lvl_lb, j + 1))
                array.set(lvl_lb, j + 1, tmpLb)

// Proximity filter
sz := array.size(lvl_price)
if sz > 1
    for i = 0 to sz - 2
        if array.get(lvl_isHidden, i)
            continue
        float dist = math.abs(array.get(lvl_price, i) - array.get(lvl_price, i + 1))
        float threshold = array.get(lvl_price, i) * proxPct / 100.0
        if dist < threshold and dist > 0
            if array.get(lvl_priority, i) <= array.get(lvl_priority, i + 1)
                array.set(lvl_isHidden, i, true)
            else
                array.set(lvl_isHidden, i + 1, true)

// =============================================================================
// PHASE B: CONFLUENCE ZONE DETECTION
// =============================================================================
if array.size(confBoxes) > 0
    for i = array.size(confBoxes) - 1 to 0
        box.delete(array.get(confBoxes, i))
    array.clear(confBoxes)

sz := array.size(lvl_price)
if sz >= confMinLvls
    int clusterStart = 0
    while clusterStart <= sz - confMinLvls
        if array.get(lvl_isHidden, clusterStart)
            clusterStart += 1
            continue
        float startPrice = array.get(lvl_price, clusterStart)
        float rangeThreshold = startPrice * confPct / 100.0
        int clusterEnd = clusterStart
        int visibleCount = 1
        for k = clusterStart + 1 to sz - 1
            if array.get(lvl_isHidden, k)
                continue
            if math.abs(array.get(lvl_price, k) - startPrice) <= rangeThreshold
                clusterEnd := k
                visibleCount += 1
            else
                break
        if visibleCount >= confMinLvls
            float minP = array.get(lvl_price, clusterStart)
            float maxP = array.get(lvl_price, clusterEnd)
            for k = clusterStart to clusterEnd
                if not array.get(lvl_isHidden, k)
                    array.set(lvl_isConfluence, k, true)
            box confBox = box.new(bar_index - 20, maxP, bar_index + 20, minP, border_color=color.new(color.orange, 50), bgcolor=color.new(#FFD700, 85), border_width=1, text="CONFLUENCE ZONE", text_color=color.new(#FFD700, 20), text_size=size.small, text_halign=text.align_center, text_valign=text.align_center)
            array.push(confBoxes, confBox)
            clusterStart := clusterEnd + 1
        else
            clusterStart += 1

// =============================================================================
// PHASE C: BREAK AND RETEST STATE MACHINE
// =============================================================================
var bool masterAlert = false
masterAlert := false

sz := array.size(lvl_price)
if sz > 0
    for i = 0 to sz - 1
        if not array.get(lvl_isActive, i) or array.get(lvl_isHidden, i)
            continue

        float lvlPrice = array.get(lvl_price, i)
        float bufferZone = atrVal * atrMult

        if not array.get(lvl_isBroken, i)
            bool brokeUp = close > lvlPrice and close[1] <= lvlPrice
            bool brokeDown = close < lvlPrice and close[1] >= lvlPrice
            bool highVol = volume > volMA

            if brokeUp and highVol
                array.set(lvl_isBroken, i, true)
                array.set(lvl_breakIsUp, i, true)
                array.set(lvl_breakVol, i, volume)
                array.set(lvl_breakBar, i, bar_index)

            if brokeDown and highVol
                array.set(lvl_isBroken, i, true)
                array.set(lvl_breakIsUp, i, false)
                array.set(lvl_breakVol, i, volume)
                array.set(lvl_breakBar, i, bar_index)

        else if array.get(lvl_isBroken, i) and not array.get(lvl_isRetested, i) and bar_index > array.get(lvl_breakBar, i)
            bool inZone = math.abs(close - lvlPrice) <= bufferZone
            bool lowVol = volume < array.get(lvl_breakVol, i)
            string curTf = array.get(lvl_tf, i)

            if array.get(lvl_breakIsUp, i)
                bool pullback = low <= lvlPrice + bufferZone and close >= lvlPrice - bufferZone
                if pullback and inZone and lowVol
                    array.set(lvl_isRetested, i, true)
                    label.new(bar_index, low - atrVal * 0.3, "SR FLIP\n" + curTf + " " + str.tostring(lvlPrice, format.mintick), style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.small)
                    if array.get(lvl_isConfluence, i)
                        masterAlert := true
            else
                bool pullback = high >= lvlPrice - bufferZone and close <= lvlPrice + bufferZone
                if pullback and inZone and lowVol
                    array.set(lvl_isRetested, i, true)
                    label.new(bar_index, high + atrVal * 0.3, "SR FLIP\n" + curTf + " " + str.tostring(lvlPrice, format.mintick), style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
                    if array.get(lvl_isConfluence, i)
                        masterAlert := true

// =============================================================================
// PHASE D: DRAWING MANAGEMENT
// =============================================================================
sz := array.size(lvl_price)
if sz > 0
    for i = 0 to sz - 1
        if array.get(lvl_isHidden, i) or not array.get(lvl_isActive, i)
            line tempLn = array.get(lvl_ln, i)
            label tempLb = array.get(lvl_lb, i)
            if not na(tempLn)
                line.delete(tempLn)
                array.set(lvl_ln, i, line(na))
            if not na(tempLb)
                label.delete(tempLb)
                array.set(lvl_lb, i, label(na))
            continue

        string curTf = array.get(lvl_tf, i)
        color lineCol = f_getColor(curTf)
        string lineStyle = f_getStyle(curTf)
        int lineWidth = f_getWidth(curTf)

        if array.get(lvl_isBroken, i) and not array.get(lvl_isRetested, i)
            lineCol := color.new(color.yellow, 30)
        if array.get(lvl_isRetested, i)
            lineCol := color.new(color.gray, 60)
        if array.get(lvl_isConfluence, i) and not array.get(lvl_isBroken, i)
            lineCol := color.new(#FFD700, 0)

        float curPrice = array.get(lvl_price, i)
        line curLn = array.get(lvl_ln, i)
        label curLb = array.get(lvl_lb, i)

        if na(curLn)
            array.set(lvl_ln, i, line.new(bar_index - 50, curPrice, bar_index + 20, curPrice, color=lineCol, style=lineStyle, width=lineWidth, extend=extend.right))
        else
            line.set_xy1(curLn, bar_index - 50, curPrice)
            line.set_xy2(curLn, bar_index + 20, curPrice)
            line.set_color(curLn, lineCol)
            line.set_style(curLn, lineStyle)
            line.set_width(curLn, lineWidth)

        string brk = ""
        if array.get(lvl_isBroken, i)
            if array.get(lvl_isRetested, i)
                brk := " FLIP"
            else
                brk := " BRK"
        string lblTxt = curTf + " " + str.tostring(curPrice, format.mintick) + brk

        if na(curLb)
            array.set(lvl_lb, i, label.new(bar_index + 25, curPrice, lblTxt, style=label.style_none, textcolor=lineCol, size=size.tiny))
        else
            label.set_xy(curLb, bar_index + 25, curPrice)
            label.set_text(curLb, lblTxt)
            label.set_textcolor(curLb, lineCol)

// =============================================================================
// PHASE E: ALERT
// =============================================================================
alertcondition(masterAlert, title="SR Flip in Confluence Zone", message="First Test SR Flip confirmed at a Major Confluence Zone")
